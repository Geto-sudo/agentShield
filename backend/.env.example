# AgentShield — configuration (copier en `.env`, tout est optionnel)

# --- Serveur ---------------------------------------------------------------
AGENTSHIELD_ADDR=127.0.0.1:8080
AGENTSHIELD_DB=data/agentshield.db
# Jeu de démonstration au premier lancement (3 agents, 3 mandats, 1 sinistre)
AGENTSHIELD_SEED=true
# URL publique utilisée pour les retours de checkout PayPal
AGENTSHIELD_PUBLIC_URL=http://127.0.0.1:8080

# --- Politique par défaut --------------------------------------------------
# 4000 = 40,00 EUR : seuil d'approbation automatique
AGENTSHIELD_AUTO_APPROVE_MAX_CENTS=4000
# Durée de vie d'une escalade avant expiration
AGENTSHIELD_APPROVAL_TTL_MINUTES=30
# Destinataire (fictif) des payouts Sandbox de démonstration
AGENTSHIELD_PAYOUT_EMAIL=sandbox-owner@example.com

# --- PayPal Sandbox --------------------------------------------------------
# Laisser vide pour rester en mode `mock` (identifiants MOCK-…, aucun réseau).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# true = force le mode simulé même si des clés sont présentes
PAYPAL_FORCE_MOCK=false

# --- Expert IA (optionnel) -------------------------------------------------
# Sans clé, l'expert tombe sur un verdict déterministe de même structure.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECS=20

# --- Journalisation --------------------------------------------------------
RUST_LOG=info,agentshield=debug
